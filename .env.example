# Application environment (development, test, production)
NODE_ENV=development

# Port number for the Express API HTTP server
API_PORT=3000

# PostgreSQL connection string for the database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simera
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/simera_test

# Initial admin account credentials (used by the admin seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password_123

# SMTP account that sends verification codes (US-02) to the candidate's real
# email. Gmail or Google Workspace (company email): turn on 2-Step Verification,
# create an App Password at https://myaccount.google.com/apppasswords and use it
# as SMTP_PASS (never the normal password). MAIL_FROM must use the SMTP_USER
# address. Another provider: use its SMTP host, port and credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM=TalentVault <your_sender_email@gmail.com>

# Login token (US-03). JWT_SECRET signs the token kept in the HttpOnly
# access_token cookie: use a long random value, e.g. the output of
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_EXPIRES_IN_HOURS is optional (default 24).
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN_HOURS=24

# File upload (US-04). Both optional. UPLOAD_STORAGE_DIR is the private folder
# for raw uploaded files (relative to the repository root; default: storage/uploads).
# MIN_EXTRACTED_TEXT_CHARS: a file with less extracted text is rejected as
# "no readable text" (default 50).
UPLOAD_STORAGE_DIR=storage/uploads
MIN_EXTRACTED_TEXT_CHARS=50

# LLM provider (US-08). OpenAI-compatible Chat Completions API.
# Changing the provider later means changing these vars only.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_MS=90000

# Skill normalization (US-13). Minimum similarity score (0 to 1) for candidate skill fuzzy matching.
SKILL_MIN_SIMILARITY=0.5
