# Application environment (development, test, production)
NODE_ENV=development

# Port number for the Express API HTTP server
API_PORT=3000

# PostgreSQL connection string for the database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simera
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/simera_test

# Initial admin account credentials (used by the admin seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password_123
